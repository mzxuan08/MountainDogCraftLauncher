<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MDCL.Desktop.ViewModels"
        x:Class="MDCL.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1320" Height="860" MinWidth="1100" MinHeight="720"
        Background="#EEF2F6"
        Title="{Binding Title}">
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="Background" Value="#E9EEF3" />
      <Setter Property="Foreground" Value="#1C2A36" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="#DEE6ED" />
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="#21A06B" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.accent:pointerover">
      <Setter Property="Background" Value="#18895A" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.play">
      <Setter Property="Background" Value="#25C281" />
      <Setter Property="Foreground" Value="#062117" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="CornerRadius" Value="11" />
    </Style>
    <Style Selector="Button.play:pointerover">
      <Setter Property="Background" Value="#3BD596" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="#24FFFFFF" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.ghost:pointerover">
      <Setter Property="Background" Value="#38FFFFFF" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#3AFFFFFF" />
      <Setter Property="Foreground" Value="#FFD7D7" />
    </Style>
    <Style Selector="Button.dark">
      <Setter Property="Background" Value="#1E2935" />
      <Setter Property="Foreground" Value="#E8EDF3" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="11,9" />
      <Setter Property="Background" Value="#F7FAFC" />
      <Setter Property="BorderBrush" Value="#D9E2EA" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Background" Value="#F7FAFC" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="White" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="20" />
      <Setter Property="BoxShadow" Value="0 4 16 0 #0D000000" />
    </Style>
    <Style Selector="TextBlock.cardTitle">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#18242F" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#6D7E8E" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#718292" />
    </Style>
    <Style Selector="TextBlock.value">
      <Setter Property="FontSize" Value="21" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#172531" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Padding" Value="15,9" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="Foreground" Value="#5B6C7B" />
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Background" Value="#DDF3E8" />
      <Setter Property="Foreground" Value="#0B6B47" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,7" />
      <Setter Property="Background" Value="#182430" />
    </Style>
    <Style Selector="ListBoxItem:pointerover">
      <Setter Property="Background" Value="#1C2C39" />
    </Style>
    <Style Selector="ListBoxItem:selected">
      <Setter Property="Background" Value="#1D5A43" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*">
    <Border Padding="22,15">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
          <GradientStop Color="#0B121B" Offset="0" />
          <GradientStop Color="#13231F" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Border Width="38" Height="38" CornerRadius="10" Background="#37D38B">
            <TextBlock Text="M" Foreground="#082218" FontWeight="Bold" FontSize="22"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" Foreground="White" FontSize="21" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Subtitle}" Foreground="#93A7B7" FontSize="11" />
          </StackPanel>
        </StackPanel>
        <Border Grid.Column="1" Background="#1CFFFFFF" CornerRadius="16" Padding="14,8"
                Margin="26,0,16,0" VerticalAlignment="Center" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Width="7" Height="7" CornerRadius="4" Background="#46E39C" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Status}" Foreground="#E4EEF5" FontSize="12"
                       MaxWidth="560" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>
        <Button Grid.Column="2" Classes="dark" Content="刷新" Command="{Binding RefreshCommand}"
                VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="318,*" Margin="16">
      <Border Background="#0F1923" CornerRadius="16" Padding="14">
        <Grid RowDefinitions="Auto,*,Auto">
          <Grid ColumnDefinitions="*,Auto" Margin="4,2,4,12">
            <StackPanel Spacing="2">
              <TextBlock Text="实例" Foreground="#F4F8FB" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="选择要启动的版本" Foreground="#7E91A3" FontSize="11" />
            </StackPanel>
            <Border Grid.Column="1" Background="#1D2A37" CornerRadius="12" Padding="9,3" VerticalAlignment="Center">
              <TextBlock Text="{Binding Instances.Count}" Foreground="#AFC0CF" FontSize="12" />
            </Border>
          </Grid>
          <ListBox Grid.Row="1" ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}"
                   Background="Transparent" BorderThickness="0" Padding="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:InstanceRow">
                <Border Background="Transparent" CornerRadius="11" Padding="10">
                  <Grid ColumnDefinitions="38,*,Auto" ColumnSpacing="9">
                    <Border Width="38" Height="38" CornerRadius="9" Background="#173D31">
                      <TextBlock Text="M" Foreground="#45DE9C" FontWeight="Bold" FontSize="20"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Manifest.DisplayName}" Foreground="#F2F7FA"
                                 FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Details}" Foreground="#8EA1B1" FontSize="11"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="›" Foreground="#5E7385" FontSize="20" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Border Grid.Row="2" Background="#0B131C" BorderBrush="#22303D" BorderThickness="1"
                  CornerRadius="13" Padding="12" Margin="0,14,0,0">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="启动器" Foreground="#91A5B7" FontSize="11" />
                <TextBlock Grid.Column="1" Text="JAVA EDITION" Foreground="#4C6478" FontSize="9" />
              </Grid>
              <Button Classes="play" Content="▶   启动游戏" Height="50"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Command="{Binding LaunchCommand}" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Grid.Column="0" Classes="accent" Content="安装 / 修复"
                        Command="{Binding InstallCommand}" />
                <Button Grid.Column="1" Classes="danger" Content="停止"
                        Command="{Binding StopCommand}" />
              </Grid>
              <TextBlock Text="{Binding ProgressText}" Foreground="#7E93A6" FontSize="10" TextWrapping="Wrap" />
              <Button Content="取消当前任务" Command="{Binding CancelCommand}" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <TabControl Grid.Column="1" Margin="16,0,0,0" Padding="0" Background="Transparent"
                  SelectedIndex="{Binding SelectedTabIndex}">
        <TabItem Header="主页">
          <ScrollViewer>
            <StackPanel Spacing="14" Margin="0,4,4,4">
              <Border CornerRadius="18" MinHeight="226" ClipToBounds="True">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#12342D" Offset="0" />
                    <GradientStop Color="#17634B" Offset="0.55" />
                    <GradientStop Color="#1F8A63" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
                <Grid ColumnDefinitions="*,250" ClipToBounds="True">
                  <StackPanel Margin="28,24" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="MINECRAFT JAVA EDITION" Foreground="#8BE7BE" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedInstance.Manifest.DisplayName, FallbackValue=创建你的第一个实例}"
                               Foreground="White" FontSize="32" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="轻量、可靠的 Minecraft 启动器。原版、Fabric、Forge 与 NeoForge 统一管理。"
                               Foreground="#C7EFDD" FontSize="13" TextWrapping="Wrap" MaxWidth="560"
                               HorizontalAlignment="Left" TextAlignment="Left" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Background="#24FFFFFF" CornerRadius="7" Padding="9,4">
                        <TextBlock Text="{Binding SelectedInstance.Manifest.BaseVersion, FallbackValue=—}"
                                   Foreground="White" FontSize="12" />
                      </Border>
                      <Border Background="#24FFFFFF" CornerRadius="7" Padding="9,4">
                        <TextBlock Text="{Binding SelectedInstance.LoaderDisplay, FallbackValue=—}"
                                   Foreground="White" FontSize="12" />
                      </Border>
                      <Border Background="#24FFFFFF" CornerRadius="7" Padding="9,4">
                        <TextBlock Text="{Binding SelectedInstance.InstallState, FallbackValue=—}"
                                   Foreground="White" FontSize="12" />
                      </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                      <Button Classes="play" Content="▶   开始游戏" MinWidth="148" Height="44"
                              Command="{Binding LaunchCommand}" />
                      <Button Classes="ghost" Content="安装 / 修复" MinWidth="110" Height="44"
                              Command="{Binding InstallCommand}" />
                    </StackPanel>
                  </StackPanel>
                  <Grid Grid.Column="1">
                    <TextBlock Text="M" Foreground="#16FFFFFF" FontSize="210" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-18,0,0" />
                    <Border Width="150" Height="150" CornerRadius="34" Background="#12FFFFFF"
                            VerticalAlignment="Center" HorizontalAlignment="Center" />
                  </Grid>
                </Grid>
              </Border>

              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                <Border Classes="card" Padding="16">
                  <StackPanel Spacing="3">
                    <TextBlock Text="游戏版本" Classes="label" />
                    <TextBlock Text="{Binding SelectedInstance.Manifest.BaseVersion, FallbackValue=—}" Classes="value" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="card" Padding="16">
                  <StackPanel Spacing="3">
                    <TextBlock Text="加载器" Classes="label" />
                    <TextBlock Text="{Binding SelectedInstance.LoaderDisplay, FallbackValue=—}" Classes="value"
                               FontSize="18" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="card" Padding="16">
                  <StackPanel Spacing="3">
                    <TextBlock Text="运行状态" Classes="label" />
                    <TextBlock Text="{Binding RunState}" Classes="value" />
                  </StackPanel>
                </Border>
              </Grid>

              <Grid ColumnDefinitions="1.45*,*" ColumnSpacing="12">
                <Border Classes="card">
                  <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="新建实例" Classes="cardTitle" />
                      <Border Background="#E9F7F0" CornerRadius="6" Padding="7,2" VerticalAlignment="Center">
                        <TextBlock Text="原版" Foreground="#168757" FontSize="10" />
                      </Border>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                      <TextBox Grid.Column="0" Text="{Binding NewInstanceName}" PlaceholderText="实例名称" />
                      <TextBox Grid.Column="1" Text="{Binding NewVersion}" PlaceholderText="版本 ID，例如 1.20.1" />
                      <Button Grid.Column="2" Classes="accent" Content="创建" Command="{Binding CreateCommand}" />
                    </Grid>
                    <TextBlock Text="从 Mojang 官方元数据解析版本、Java 要求与资源，不复制来源不明的客户端。"
                               Classes="muted" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="card">
                  <StackPanel Spacing="8">
                    <TextBlock Text="当前任务" Classes="cardTitle" />
                    <Border Background="#FFF8EB" CornerRadius="9" Padding="10">
                      <TextBlock Text="{Binding Status}" Foreground="#8A5A12" FontSize="12" TextWrapping="Wrap" />
                    </Border>
                    <TextBlock Text="加载器、模组、整合包与账号在顶部标签页中管理。" Classes="muted" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </Grid>

              <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                <Border Classes="card" Padding="16">
                  <StackPanel Spacing="6">
                    <Border Width="32" Height="32" CornerRadius="9" Background="#E9F7F0" HorizontalAlignment="Left">
                      <TextBlock Text="L" Foreground="#168757" FontWeight="Bold" FontSize="16"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="加载器" FontWeight="SemiBold" Foreground="#18242F" />
                    <TextBlock Text="Fabric / Forge / NeoForge" Classes="muted" TextWrapping="Wrap" />
                    <Button Content="管理加载器" Command="{Binding OpenLoadersCommand}" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="card" Padding="16">
                  <StackPanel Spacing="6">
                    <Border Width="32" Height="32" CornerRadius="9" Background="#EEF2FF" HorizontalAlignment="Left">
                      <TextBlock Text="M" Foreground="#4A58B8" FontWeight="Bold" FontSize="16"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="模组" FontWeight="SemiBold" Foreground="#18242F" />
                    <TextBlock Text="本地启停 / Modrinth" Classes="muted" TextWrapping="Wrap" />
                    <Button Content="管理模组" Command="{Binding OpenModsCommand}" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="card" Padding="16">
                  <StackPanel Spacing="6">
                    <Border Width="32" Height="32" CornerRadius="9" Background="#FFF0E5" HorizontalAlignment="Left">
                      <TextBlock Text="P" Foreground="#B85E17" FontWeight="Bold" FontSize="16"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="整合包" FontWeight="SemiBold" Foreground="#18242F" />
                    <TextBlock Text="导入 .mrpack 实例" Classes="muted" TextWrapping="Wrap" />
                    <Button Content="导入整合包" Command="{Binding OpenPacksCommand}" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="3" Classes="card" Padding="16">
                  <StackPanel Spacing="6">
                    <Border Width="32" Height="32" CornerRadius="9" Background="#EAF4FF" HorizontalAlignment="Left">
                      <TextBlock Text="A" Foreground="#2776A8" FontWeight="Bold" FontSize="16"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="账号" FontWeight="SemiBold" Foreground="#18242F" />
                    <TextBlock Text="本地身份 / 微软登录" Classes="muted" TextWrapping="Wrap" />
                    <Button Content="管理账号" Command="{Binding OpenAccountsCommand}" />
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="加载器">
          <ScrollViewer>
            <StackPanel Spacing="14" Margin="0,4,4,4">
              <Border Classes="card">
                <StackPanel Spacing="12">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Width="34" Height="34" CornerRadius="9" Background="#E9F7F0">
                      <TextBlock Text="F" Foreground="#168757" FontWeight="Bold" FontSize="17"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Fabric" Classes="cardTitle" />
                      <TextBlock Text="轻量模组加载器，留空使用最新稳定版本。" Classes="muted" />
                    </StackPanel>
                  </StackPanel>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBox Grid.Column="0" Text="{Binding FabricVersion}" PlaceholderText="Fabric loader 版本（空 = 最新稳定）" />
                    <Button Grid.Column="1" Classes="accent" Content="安装 Fabric" Command="{Binding InstallFabricCommand}" />
                  </Grid>
                </StackPanel>
              </Border>

              <Border Classes="card">
                <StackPanel Spacing="12">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Width="34" Height="34" CornerRadius="9" Background="#FFF0E5">
                      <TextBlock Text="F" Foreground="#B85E17" FontWeight="Bold" FontSize="17"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Forge / NeoForge" Classes="cardTitle" />
                      <TextBlock Text="必须固定版本；Forge 与 NeoForge 分开安装，不共用结果。" Classes="muted" />
                    </StackPanel>
                  </StackPanel>
                  <TextBox Text="{Binding ForgeVersion}" PlaceholderText="例如 47.2.0 / 47.1.106" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Grid.Column="0" Content="安装 Forge" Command="{Binding InstallForgeCommand}" />
                    <Button Grid.Column="1" Content="安装 NeoForge" Command="{Binding InstallNeoForgeCommand}" />
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="模组">
          <Grid ColumnDefinitions="*,*" ColumnSpacing="14" Margin="0,4,4,4">
            <Border Classes="card">
              <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
                <TextBlock Text="本地模组" Classes="cardTitle" />
                <TextBlock Grid.Row="1" Text="仅操作当前实例的 mods 目录；游戏运行中禁止修改。" Classes="muted" TextWrapping="Wrap" />
                <ListBox Grid.Row="2" ItemsSource="{Binding LocalMods}" SelectedItem="{Binding SelectedLocalMod}"
                         Background="#F7FAFC" CornerRadius="10" Padding="6">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LocalModRow">
                      <TextBlock Text="{Binding Display}" TextWrapping="Wrap" FontSize="12" Margin="6,3" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="8">
                  <Button Grid.Column="0" Content="刷新模组" Command="{Binding RefreshModsCommand}" />
                  <Button Grid.Column="1" Content="启用 / 禁用" Command="{Binding ToggleModCommand}" />
                </Grid>
              </Grid>
            </Border>

            <Border Grid.Column="1" Classes="card">
              <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10">
                <TextBlock Text="Modrinth" Classes="cardTitle" />
                <TextBlock Grid.Row="1" Text="按当前实例的游戏版本和加载器筛选，安装到实例 mods。" Classes="muted" TextWrapping="Wrap" />
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox Grid.Column="0" Text="{Binding ModrinthQuery}" PlaceholderText="搜索模组名称" />
                  <Button Grid.Column="1" Classes="accent" Content="搜索" Command="{Binding SearchModrinthCommand}" />
                </Grid>
                <ListBox Grid.Row="3" ItemsSource="{Binding ModrinthProjects}" SelectedItem="{Binding SelectedModrinthProject}"
                         Background="#F7FAFC" CornerRadius="10" Padding="6">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ModrinthProjectRow">
                      <TextBlock Text="{Binding Display}" TextWrapping="Wrap" FontSize="12" Margin="6,3" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Button Grid.Row="4" Classes="accent" Content="安装所选模组到当前实例"
                        Command="{Binding InstallModrinthCommand}" />
              </Grid>
            </Border>
          </Grid>
        </TabItem>

        <TabItem Header="整合包">
          <ScrollViewer>
            <StackPanel Spacing="14" Margin="0,4,4,4">
              <Border Classes="card">
                <StackPanel Spacing="12">
                  <TextBlock Text="导入 .mrpack" Classes="cardTitle" />
                  <TextBlock Text="创建新实例，不覆盖现有存档；包内自定义脚本不会执行。"
                             Classes="muted" TextWrapping="Wrap" />
                  <TextBox Text="{Binding MrpackPath}" PlaceholderText="本地 .mrpack 文件完整路径" />
                  <TextBox Text="{Binding MrpackInstanceName}" PlaceholderText="新实例名称" />
                  <Button Content="预览整合包" Command="{Binding PreviewMrpackCommand}" />
                  <TextBlock Text="{Binding MrpackPreviewText}" TextWrapping="Wrap" />
                  <Button Classes="accent" Content="确认导入 / 恢复未完成导入" Command="{Binding ImportMrpackCommand}" />
                </StackPanel>
              </Border>
              <Border Classes="card">
                <StackPanel Spacing="8">
                  <TextBlock Text="导入内容" Classes="cardTitle" />
                  <TextBlock Text="索引文件摘要校验、加载器安装、文件下载、overrides 合并。支持 Vanilla、Fabric、Forge 与 NeoForge 固定版本导入。"
                             Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="账号">
          <ScrollViewer>
            <StackPanel Spacing="14" Margin="0,4,4,4">
              <Border Classes="card">
                <StackPanel Spacing="12">
                  <TextBlock Text="当前账号" Classes="cardTitle" />
                  <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:AccountRow">
                        <TextBlock Text="{Binding Display}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0" Text="{Binding LocalDisplayName}" PlaceholderText="本地身份名称" />
                    <Button Grid.Column="1" Content="添加本地身份" Command="{Binding AddLocalCommand}" />
                    <Button Grid.Column="2" Classes="accent" Content="微软登录" Command="{Binding LoginMicrosoftCommand}" />
                  </Grid>
                  <TextBlock Text="本地身份不提供正版会话。微软登录需要 MDCL 专属 public client；未配置时会明确提示条件不足。"
                             Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="日志">
          <Grid RowDefinitions="Auto,*" Margin="0,4,4,4" RowSpacing="10">
            <Border Classes="card" Padding="16">
              <StackPanel Spacing="4">
                <TextBlock Text="运行状态" Classes="cardTitle" />
                <TextBlock Text="{Binding Status}" Foreground="#8A5A12" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Grid.Row="1" Background="#0C131A" CornerRadius="14" Padding="12">
              <ListBox ItemsSource="{Binding Logs}" Background="Transparent" BorderThickness="0"
                       FontFamily="Cascadia Mono,Consolas,Menlo" FontSize="12">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" Foreground="#C8D6E5" TextWrapping="Wrap" Margin="2" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
          </Grid>
        </TabItem>
      </TabControl>
    </Grid>
  </Grid>
</Window>
