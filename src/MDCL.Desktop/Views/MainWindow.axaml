<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MDCL.Desktop.ViewModels"
        x:Class="MDCL.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1120" Height="780" MinWidth="920" MinHeight="640"
        Title="{Binding Title}">
  <Grid RowDefinitions="Auto,*" Background="#F4F6F8">
    <Border Grid.Row="0" Background="#171B24" Padding="24,16">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Border Width="34" Height="34" CornerRadius="8" Background="#66C08A">
          <TextBlock Text="M" Foreground="#102318" FontWeight="Bold" FontSize="20"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}" Foreground="White" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Subtitle}" Foreground="#AAB3C2" FontSize="12" />
        </StackPanel>
        <Button Content="刷新" Command="{Binding RefreshCommand}" Margin="28,0,0,0" VerticalAlignment="Center" />
        <Border Background="#2B3443" CornerRadius="12" Padding="10,5" VerticalAlignment="Center">
          <TextBlock Text="{Binding Status}" Foreground="#E6EAF0" MaxWidth="520" TextTrimming="CharacterEllipsis" />
        </Border>
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="330,*" Margin="18">
      <Border Background="#202632" CornerRadius="12" Padding="16">
        <Grid RowDefinitions="Auto,*,Auto">
          <TextBlock Text="实例" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
          <ListBox Grid.Row="1" ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}"
                   Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:InstanceRow">
                <Border Background="#2B3443" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                  <TextBlock Text="{Binding Display}" Foreground="#E6EAF0" TextWrapping="Wrap" />
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="2" Spacing="8" Margin="0,12,0,0">
            <Button Content="安装 / 修复当前实例" Command="{Binding InstallCommand}" HorizontalAlignment="Stretch" />
            <TextBox Text="{Binding FabricVersion}" PlaceholderText="Fabric loader 版本（空=最新稳定）" />
            <Button Content="安装 Fabric" Command="{Binding InstallFabricCommand}" HorizontalAlignment="Stretch" />
            <Grid ColumnDefinitions="*,*">
              <Button Grid.Column="0" Content="启动" Command="{Binding LaunchCommand}" Margin="0,0,4,0" />
              <Button Grid.Column="1" Content="停止" Command="{Binding StopCommand}" Margin="4,0,0,0" />
            </Grid>
            <TextBlock Text="{Binding ProgressText}" Foreground="#8FA3BF" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>

      <ScrollViewer Grid.Column="1" Margin="18,0,0,0">
        <StackPanel Spacing="14">
          <Border Background="White" CornerRadius="12" Padding="18">
            <StackPanel Spacing="10">
              <TextBlock Text="创建原版实例" FontSize="18" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="10">
                <TextBox Grid.Column="0" Text="{Binding NewInstanceName}" PlaceholderText="实例名称" />
                <TextBox Grid.Column="1" Text="{Binding NewVersion}" PlaceholderText="版本 ID，例如 1.20.1 或 26.3" />
                <Button Grid.Column="2" Content="创建" Command="{Binding CreateCommand}" />
              </Grid>
              <TextBlock Text="安装会从 Mojang 官方元数据解析版本与 Java 要求，下载并校验客户端、库、资源与日志配置。"
                         Foreground="#68758A" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Background="White" CornerRadius="12" Padding="18">
            <StackPanel Spacing="10">
              <TextBlock Text="本地模组" FontSize="18" FontWeight="SemiBold" />
              <ListBox ItemsSource="{Binding LocalMods}" SelectedItem="{Binding SelectedLocalMod}" Height="140">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:LocalModRow">
                    <TextBlock Text="{Binding Display}" TextWrapping="Wrap" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Grid.Column="0" Content="刷新模组" Command="{Binding RefreshModsCommand}" />
                <Button Grid.Column="1" Content="启用 / 禁用" Command="{Binding ToggleModCommand}" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Background="White" CornerRadius="12" Padding="18">
            <StackPanel Spacing="10">
              <TextBlock Text="Modrinth 模组" FontSize="18" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Grid.Column="0" Text="{Binding ModrinthQuery}" PlaceholderText="搜索模组名称" />
                <Button Grid.Column="1" Content="搜索" Command="{Binding SearchModrinthCommand}" />
              </Grid>
              <ListBox ItemsSource="{Binding ModrinthProjects}" SelectedItem="{Binding SelectedModrinthProject}" Height="150">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ModrinthProjectRow">
                    <TextBlock Text="{Binding Display}" TextWrapping="Wrap" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Button Content="安装所选模组到当前实例" Command="{Binding InstallModrinthCommand}" HorizontalAlignment="Stretch" />
            </StackPanel>
          </Border>

          <Border Background="White" CornerRadius="12" Padding="18">
            <StackPanel Spacing="10">
              <TextBlock Text="账号" FontSize="18" FontWeight="SemiBold" />
              <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:AccountRow">
                    <TextBlock Text="{Binding Display}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBox Grid.Column="0" Text="{Binding LocalDisplayName}" PlaceholderText="本地身份名称" />
                <Button Grid.Column="1" Content="添加本地身份" Command="{Binding AddLocalCommand}" />
                <Button Grid.Column="2" Content="微软登录" Command="{Binding LoginMicrosoftCommand}" />
              </Grid>
              <TextBlock Text="本地身份不提供正版会话；微软登录需要配置 MDCL 专属 public client，否则会明确提示条件不足。"
                         Foreground="#68758A" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Background="White" CornerRadius="12" Padding="18">
            <StackPanel Spacing="10">
              <TextBlock Text="运行状态与日志" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Status}" Foreground="#8A4F12" TextWrapping="Wrap" />
              <Border Background="#11151D" CornerRadius="8" Padding="10">
                <ListBox ItemsSource="{Binding Logs}" Height="230" Background="Transparent" BorderThickness="0"
                         FontFamily="Cascadia Mono,Consolas,Menlo" FontSize="12">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" Foreground="#C8D2E0" TextWrapping="Wrap" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
