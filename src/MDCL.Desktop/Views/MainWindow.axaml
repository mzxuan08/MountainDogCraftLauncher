<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MDCL.Desktop.ViewModels" x:Class="MDCL.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel" Width="1200" Height="800" MinWidth="1100" MinHeight="720"
        Background="#EAF3FA" Foreground="#263D50" FontFamily="Microsoft YaHei UI,Segoe UI,PingFang SC"
        Title="{Binding Title}" WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#176DA6"/>
      <Setter Property="BorderBrush" Value="#B9D3E5"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="14,8"/>
      <Setter Property="MinHeight" Value="36"/><Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="Button:pointerover"><Setter Property="Background" Value="#E6F4FF"/><Setter Property="BorderBrush" Value="#1479BF"/></Style>
    <Style Selector="Button.accent"><Setter Property="Background" Value="#1479BF"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#1479BF"/></Style>
    <Style Selector="Button.accent:pointerover"><Setter Property="Background" Value="#1067A5"/></Style>
    <Style Selector="Button.play"><Setter Property="Background" Value="#1479BF"/><Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="Button.play:pointerover"><Setter Property="Background" Value="#1067A5"/></Style>
    <Style Selector="Button:disabled"><Setter Property="Opacity" Value="0.45"/></Style>
    <Style Selector="Button.link"><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0,6"/><Setter Property="HorizontalAlignment" Value="Left"/></Style>
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="11,8"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#B9CDDD"/><Setter Property="FontSize" Value="13"/></Style>
    <Style Selector="ComboBox"><Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="10,7"/><Setter Property="Background" Value="White"/><Setter Property="FontSize" Value="13"/></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="22"/><Setter Property="BoxShadow" Value="0 2 8 0 #100F3654"/></Style>
    <Style Selector="TextBlock.cardTitle"><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#176DA6"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#526B7C"/></Style>
    <Style Selector="TextBlock.pageTitle"><Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#205779"/></Style>
    <Style Selector="ListBox"><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="ListBoxItem"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,2"/><Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="{TemplateBinding CornerRadius}"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/></Border></ControlTemplate></Setter>
    </Style>
    <Style Selector="ListBoxItem:pointerover"><Setter Property="Background" Value="#ECF5FC"/></Style>
    <Style Selector="ListBoxItem:selected"><Setter Property="Background" Value="#DFEEFA"/><Setter Property="Foreground" Value="#126FAE"/></Style>
    <Style Selector="ListBox.nav ListBoxItem"><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="17,16"/><Setter Property="Margin" Value="0"/><Setter Property="CornerRadius" Value="0"/><Setter Property="FontSize" Value="15"/></Style>
    <Style Selector="ListBox.nav ListBoxItem:selected"><Setter Property="Background" Value="#27FFFFFF"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="ListBox.nav ListBoxItem:pointerover"><Setter Property="Background" Value="#20FFFFFF"/></Style>
    <Style Selector="TabControl.pages">
      <Setter Property="Template"><ControlTemplate><Grid RowDefinitions="0,*"><ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" Height="0" Opacity="0" IsHitTestVisible="False"/><Panel Grid.Row="1" ClipToBounds="True"><ContentPresenter Name="PART_SelectedContentHost2" IsVisible="False"/><ContentPresenter Name="PART_SelectedContentHost"/></Panel></Grid></ControlTemplate></Setter>
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="56,*,Auto">
    <Border>
      <Border.Background><LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%"><GradientStop Color="#168BD2" Offset="0"/><GradientStop Color="#146AB2" Offset="1"/></LinearGradientBrush></Border.Background>
      <Grid ColumnDefinitions="258,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="11" Margin="22,0" VerticalAlignment="Center">
          <Path Width="27" Height="25" Stretch="Uniform" Stroke="White" StrokeThickness="2.2" Data="M 1,23 L 10,3 L 16,15 L 21,7 L 29,23 Z M 6,13 L 11,16 L 14,12"/>
          <TextBlock Text="MDCL" Foreground="White" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
        <ListBox Classes="nav" Grid.Column="1" ItemsSource="{Binding Navigation}" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" Padding="0" VerticalAlignment="Stretch">
          <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
        </ListBox>
        <Button Grid.Column="2" Content="刷新" Command="{Binding RefreshCommand}" Margin="8,10,18,10" Background="#20FFFFFF" BorderBrush="#55FFFFFF" Foreground="White"/>
      </Grid>
    </Border>
    <Grid Grid.Row="1" ColumnDefinitions="258,*">
      <Border Background="White" BorderBrush="#D8E5EF" BorderThickness="0,0,1,0" Padding="20,22,20,16">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="17">
          <StackPanel Spacing="10">
            <TextBlock Text="游戏账号" Classes="cardTitle"/>
            <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" HorizontalAlignment="Stretch" PlaceholderText="请选择账号">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:AccountRow"><TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <Button Classes="link" Content="添加账号 / 管理账号" Command="{Binding OpenAccountsCommand}"/>
          </StackPanel>
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto"><TextBlock Text="版本选择" Classes="cardTitle"/><TextBlock Grid.Column="1" Text="{Binding Instances.Count}" Classes="muted" VerticalAlignment="Center"/></Grid>
          <ListBox Grid.Row="2" ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}" Background="Transparent" Padding="0">
            <ListBox.ItemTemplate><DataTemplate x:DataType="vm:InstanceRow">
              <StackPanel Spacing="4" Margin="1,4"><TextBlock Text="{Binding Manifest.DisplayName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Details}" FontSize="11" Foreground="#526B7C" TextWrapping="Wrap"/></StackPanel>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="3" Spacing="9">
            <TextBlock Text="{Binding SelectedInstance.Manifest.DisplayName, FallbackValue=请先创建或选择实例}" Classes="muted" TextTrimming="CharacterEllipsis"/>
            <Button Classes="play" Content="启动游戏" Height="64" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding LaunchCommand}"/>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Content="安装 / 修复" Command="{Binding InstallCommand}"/><Button Grid.Column="1" Content="停止游戏" Command="{Binding StopCommand}"/></Grid>
            <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" Height="3" Foreground="#1479BF"/>
            <TextBlock Text="{Binding ProgressText}" Classes="muted" FontSize="11" TextWrapping="Wrap" MaxHeight="48"/>
            <Button Content="取消当前任务" Command="{Binding CancelCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Border>
      <TabControl Classes="pages" Grid.Column="1" Margin="24" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent">
        <TabItem Header="启动">
          <ScrollViewer>
            <StackPanel Spacing="18" Margin="0,0,4,4">
              <StackPanel Spacing="7" Margin="2,2,0,5"><TextBlock Text="开始你的下一段旅程" Classes="pageTitle"/><TextBlock Text="选择版本，准备好账号，然后出发。" Classes="muted"/></StackPanel>
              <Border Classes="card">
                <StackPanel Spacing="13">
                  <TextBlock Text="当前游戏" Classes="cardTitle"/>
                  <TextBlock Text="{Binding SelectedInstance.Manifest.DisplayName, FallbackValue=还没有选择实例}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding SelectedInstance.Details, FallbackValue=在下方创建原版实例，再从左侧选择。}" Classes="muted" TextWrapping="Wrap"/>
                  <Border Height="1" Background="#E5EEF5" Margin="0,3"/>
                  <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="8">
                    <TextBlock Text="运行状态" Classes="muted"/><TextBlock Grid.Column="1" Text="{Binding RunState}"/>
                    <TextBlock Grid.Row="1" Text="账号" Classes="muted"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedAccount.Display, FallbackValue=请在左侧添加账号}" TextWrapping="Wrap"/>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Classes="card">
                <StackPanel Spacing="13">
                  <TextBlock Text="添加游戏版本" Classes="cardTitle"/>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><StackPanel Spacing="6"><TextBlock Text="实例名称" Classes="muted"/><TextBox Text="{Binding NewInstanceName}" PlaceholderText="例如：我的原版"/></StackPanel><StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Minecraft 版本 ID" Classes="muted"/><TextBox Text="{Binding NewVersion}" PlaceholderText="例如：1.20.1"/></StackPanel></Grid>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="15"><TextBlock Text="创建后点击左侧「安装 / 修复」，下载完成后即可启动。" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center"/><Button Grid.Column="1" Classes="accent" Content="创建实例" Command="{Binding CreateCommand}"/></Grid>
                </StackPanel>
              </Border>
              <Border Classes="card">
                <StackPanel Spacing="12"><TextBlock Text="扩展你的游戏" Classes="cardTitle"/>
                  <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4"><TextBlock Text="安装加载器" FontWeight="SemiBold"/><TextBlock Text="为当前实例安装 Fabric、Forge 或 NeoForge。" Classes="muted" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Content="管理加载器" Command="{Binding OpenLoadersCommand}"/></Grid>
                  <Border Height="1" Background="#E5EEF5"/>
                  <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4"><TextBlock Text="模组与整合包" FontWeight="SemiBold"/><TextBlock Text="管理本地模组、搜索 Modrinth，或导入 .mrpack。" Classes="muted" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="模组" Command="{Binding OpenModsCommand}"/><Button Content="整合包" Command="{Binding OpenPacksCommand}"/></StackPanel></Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="加载器">
          <ScrollViewer>
            <StackPanel Spacing="14" Margin="0,0,4,4">
              <Border Classes="card">
                <StackPanel Spacing="12">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Width="34" Height="34" CornerRadius="9" Background="#EAF5FC">
                      <TextBlock Text="F" Foreground="#1479BF" FontWeight="Bold" FontSize="17"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Fabric" Classes="cardTitle" />
                      <TextBlock Text="轻量模组加载器，留空使用最新稳定版本。" Classes="muted" />
                    </StackPanel>
                  </StackPanel>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBox Grid.Column="0" Text="{Binding FabricVersion}" PlaceholderText="Fabric loader 版本（空 = 最新稳定）" />
                    <Button Grid.Column="1" Classes="accent" Content="安装 Fabric" Command="{Binding InstallFabricCommand}" />
                  </Grid>
                </StackPanel>
              </Border>

              <Border Classes="card">
                <StackPanel Spacing="12">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Width="34" Height="34" CornerRadius="9" Background="#FFF0E5">
                      <TextBlock Text="F" Foreground="#B85E17" FontWeight="Bold" FontSize="17"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Forge / NeoForge" Classes="cardTitle" />
                      <TextBlock Text="必须固定版本；Forge 与 NeoForge 分开安装，不共用结果。" Classes="muted" />
                    </StackPanel>
                  </StackPanel>
                  <TextBox Text="{Binding ForgeVersion}" PlaceholderText="例如 47.2.0 / 47.1.106" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Grid.Column="0" Content="安装 Forge" Command="{Binding InstallForgeCommand}" />
                    <Button Grid.Column="1" Content="安装 NeoForge" Command="{Binding InstallNeoForgeCommand}" />
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="模组">
          <Grid ColumnDefinitions="*,*" ColumnSpacing="14" Margin="0,0,4,4">
            <Border Classes="card">
              <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
                <TextBlock Text="本地模组" Classes="cardTitle" />
                <TextBlock Grid.Row="1" Text="仅操作当前实例的 mods 目录；游戏运行中禁止修改。" Classes="muted" TextWrapping="Wrap" />
                <ListBox Grid.Row="2" ItemsSource="{Binding LocalMods}" SelectedItem="{Binding SelectedLocalMod}"
                         Background="#F6F9FC" CornerRadius="5" Padding="6">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LocalModRow">
                      <TextBlock Text="{Binding Display}" TextWrapping="Wrap" FontSize="12" Margin="6,3" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="8">
                  <Button Grid.Column="0" Content="刷新模组" Command="{Binding RefreshModsCommand}" />
                  <Button Grid.Column="1" Content="启用 / 禁用" Command="{Binding ToggleModCommand}" />
                </Grid>
              </Grid>
            </Border>

            <Border Grid.Column="1" Classes="card">
              <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10">
                <TextBlock Text="Modrinth" Classes="cardTitle" />
                <TextBlock Grid.Row="1" Text="按当前实例的游戏版本和加载器筛选，安装到实例 mods。" Classes="muted" TextWrapping="Wrap" />
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox Grid.Column="0" Text="{Binding ModrinthQuery}" PlaceholderText="搜索模组名称" />
                  <Button Grid.Column="1" Classes="accent" Content="搜索" Command="{Binding SearchModrinthCommand}" />
                </Grid>
                <ListBox Grid.Row="3" ItemsSource="{Binding ModrinthProjects}" SelectedItem="{Binding SelectedModrinthProject}"
                         Background="#F6F9FC" CornerRadius="5" Padding="6">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ModrinthProjectRow">
                      <TextBlock Text="{Binding Display}" TextWrapping="Wrap" FontSize="12" Margin="6,3" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Button Grid.Row="4" Classes="accent" Content="安装所选模组到当前实例"
                        Command="{Binding InstallModrinthCommand}" />
              </Grid>
            </Border>
          </Grid>
        </TabItem>

        <TabItem Header="整合包">
          <ScrollViewer>
            <StackPanel Spacing="14" Margin="0,0,4,4">
              <Border Classes="card">
                <StackPanel Spacing="12">
                  <TextBlock Text="导入 .mrpack" Classes="cardTitle" />
                  <TextBlock Text="创建新实例，不覆盖现有存档；包内自定义脚本不会执行。"
                             Classes="muted" TextWrapping="Wrap" />
                  <TextBox Text="{Binding MrpackPath}" PlaceholderText="本地 .mrpack 文件完整路径" />
                  <TextBox Text="{Binding MrpackInstanceName}" PlaceholderText="新实例名称" />
                  <Button Content="预览整合包" Command="{Binding PreviewMrpackCommand}" />
                  <TextBlock Text="{Binding MrpackPreviewText}" TextWrapping="Wrap" />
                  <Button Classes="accent" Content="确认导入 / 恢复未完成导入" Command="{Binding ImportMrpackCommand}" />
                </StackPanel>
              </Border>
              <Border Classes="card">
                <StackPanel Spacing="8">
                  <TextBlock Text="导入内容" Classes="cardTitle" />
                  <TextBlock Text="索引文件摘要校验、加载器安装、文件下载、overrides 合并。支持 Vanilla、Fabric、Forge 与 NeoForge 固定版本导入。"
                             Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="账号">
          <ScrollViewer>
            <StackPanel Spacing="14" Margin="0,0,4,4">
              <Border Classes="card">
                <StackPanel Spacing="12">
                  <TextBlock Text="当前账号" Classes="cardTitle" />
                  <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:AccountRow">
                        <TextBlock Text="{Binding Display}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Content="退出 / 移除当前账号" Command="{Binding LogoutCommand}" />
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0" Text="{Binding LocalDisplayName}" PlaceholderText="本地身份名称" />
                    <Button Grid.Column="1" Content="添加本地身份" Command="{Binding AddLocalCommand}" />
                    <Button Grid.Column="2" Classes="accent" Content="微软登录" Command="{Binding LoginMicrosoftCommand}" />
                  </Grid>
                  <TextBlock Text="本地身份不提供正版会话。微软登录需要 MDCL 专属 public client；未配置时会明确提示条件不足。"
                             Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="日志">
          <Grid RowDefinitions="Auto,*" Margin="0,0,4,4" RowSpacing="10">
            <Border Classes="card" Padding="16">
              <StackPanel Spacing="4">
                <TextBlock Text="运行状态" Classes="cardTitle" />
                <TextBlock Text="{Binding Status}" Foreground="#8A5A12" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Content="生成诊断预览" Command="{Binding PreviewDiagnosticsCommand}" />
                  <Button Content="导出已预览诊断包" Command="{Binding ExportDiagnosticsCommand}" />
                </StackPanel>
                <TextBox Text="{Binding DiagnosticPreview}" IsReadOnly="True" AcceptsReturn="True" MaxHeight="160" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Grid.Row="1" Background="#21384C" CornerRadius="6" Padding="12">
              <ListBox ItemsSource="{Binding Logs}" Background="Transparent" BorderThickness="0"
                       FontFamily="Cascadia Mono,Consolas,Menlo" FontSize="12">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" Foreground="#E1ECF4" TextWrapping="Wrap" Margin="2" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
          </Grid>
        </TabItem>
        <TabItem Header="设置">
          <ScrollViewer>
            <StackPanel Spacing="14" Margin="0,0,4,4">
              <Border Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Text="当前实例设置" Classes="cardTitle" />
                  <TextBlock Text="实例名称" />
                  <TextBox Text="{Binding EditInstanceName}" />
                  <TextBlock Text="内存（MiB）" />
                  <NumericUpDown Value="{Binding EditMemoryMiB}" Minimum="512" Maximum="131072" Increment="512" />
                  <TextBlock Text="Java 选择" />
                  <ComboBox ItemsSource="{Binding JavaRuntimes}" SelectedItem="{Binding SelectedJavaRuntime}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:JavaRuntimeRow"><TextBlock Text="{Binding Display}" /></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="重新发现 Java" Command="{Binding RefreshJavaCommand}" />
                    <Button Classes="accent" Content="保存实例设置" Command="{Binding SaveInstanceSettingsCommand}" />
                  </StackPanel>
                  <TextBlock Text="手动绑定失效时会显示错误；选择自动并保存后，恢复按版本和架构选择。" TextWrapping="Wrap" Classes="muted" />
                </StackPanel>
              </Border>
              <Border Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Text="复制与回收" Classes="cardTitle" />
                  <TextBox Text="{Binding CopyInstanceName}" PlaceholderText="副本名称" />
                  <Button Content="复制当前实例" Command="{Binding CopyInstanceCommand}" />
                  <TextBlock Text="当前实例及其目录将移入 MDCL 回收区，共享下载库保留。可在下方恢复；运行中的实例不能移动。" TextWrapping="Wrap" />
                  <CheckBox Content="确认将左侧当前实例移入回收区" IsChecked="{Binding ConfirmTrash}" />
                  <Button Content="移入回收区" Command="{Binding TrashInstanceCommand}" />
                  <ComboBox ItemsSource="{Binding TrashInstances}" SelectedItem="{Binding SelectedTrashInstance}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:InstanceRow"><TextBlock Text="{Binding Manifest.DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Content="恢复选中的实例" Command="{Binding RestoreInstanceCommand}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Grid>
    <Border Grid.Row="2" Background="#DFEDF7" Padding="18,7"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Status}" Foreground="#365F7B" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="MDCL · Java Edition" Foreground="#526B7C" FontSize="11" Margin="20,0,0,0"/></Grid></Border>
  </Grid>
</Window>
