<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MDCL.Desktop.ViewModels"
        x:Class="MDCL.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1280" Height="840" MinWidth="1020" MinHeight="700"
        Background="#EEF1F4"
        Title="{Binding Title}">
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="Background" Value="#E8EDF2" />
      <Setter Property="Foreground" Value="#1D2A36" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="#DCE4EB" />
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="#2F7D5A" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.accent:pointerover">
      <Setter Property="Background" Value="#276A4D" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#F6E8E8" />
      <Setter Property="Foreground" Value="#A33A3A" />
    </Style>
    <Style Selector="Button.dark">
      <Setter Property="Background" Value="#26313E" />
      <Setter Property="Foreground" Value="#E8EDF3" />
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Background" Value="#2A3542" />
      <Setter Property="Foreground" Value="#A9B8C7" />
    </Style>
    <Style Selector="Button.accent:disabled">
      <Setter Property="Background" Value="#2C4B3D" />
      <Setter Property="Foreground" Value="#A9C9B8" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="11,9" />
      <Setter Property="Background" Value="#F8FAFC" />
      <Setter Property="BorderBrush" Value="#D7DFE8" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Background" Value="#F8FAFC" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="White" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="20" />
    </Style>
    <Style Selector="TextBlock.cardTitle">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#1B2733" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#69798A" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="Foreground" Value="#5F6D7C" />
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Foreground" Value="#1B2733" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*">
    <Border Background="#111820" Padding="24,14">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Border Width="36" Height="36" CornerRadius="9" Background="#66C08A">
            <TextBlock Text="M" Foreground="#102318" FontWeight="Bold" FontSize="21"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" Foreground="White" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Subtitle}" Foreground="#9EABBA" FontSize="11" />
          </StackPanel>
        </StackPanel>
        <Border Grid.Column="1" Background="#1E2935" CornerRadius="16" Padding="14,8"
                Margin="28,0,16,0" VerticalAlignment="Center" HorizontalAlignment="Left">
          <TextBlock Text="{Binding Status}" Foreground="#DCE6F0" FontSize="12"
                     MaxWidth="520" TextTrimming="CharacterEllipsis" />
        </Border>
        <Button Grid.Column="2" Classes="dark" Content="刷新" Command="{Binding RefreshCommand}"
                VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="300,*" Margin="16">
      <Border Background="#18212B" CornerRadius="14" Padding="14">
        <Grid RowDefinitions="Auto,*,Auto">
          <Grid ColumnDefinitions="*,Auto" Margin="4,0,4,12">
            <TextBlock Text="实例" Foreground="#F2F6FA" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="{Binding Instances.Count}" Foreground="#8FA0B2"
                       FontSize="12" VerticalAlignment="Center" />
          </Grid>
          <ListBox Grid.Row="1" ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}"
                   Background="Transparent" BorderThickness="0" Padding="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:InstanceRow">
                <Border Background="#212C38" CornerRadius="9" Padding="12,10" Margin="0,0,0,8">
                  <StackPanel Spacing="3">
                    <TextBlock Text="{Binding Manifest.DisplayName}" Foreground="#F0F4F8"
                               FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Details}" Foreground="#93A4B6" FontSize="11" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Border Grid.Row="2" Background="#111923" BorderBrush="#2B3846" BorderThickness="1"
                  CornerRadius="11" Padding="11" Margin="0,14,0,0">
            <StackPanel Spacing="9">
              <TextBlock Text="实例操作" Foreground="#8193A6" FontSize="11" />
              <Button Classes="accent" Content="安装 / 修复当前实例"
                      Command="{Binding InstallCommand}" HorizontalAlignment="Stretch" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Grid.Column="0" Classes="accent" Content="启动" Height="42"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Command="{Binding LaunchCommand}" />
                <Button Grid.Column="1" Classes="danger" Content="停止" Height="42"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Command="{Binding StopCommand}" />
              </Grid>
              <TextBlock Text="{Binding ProgressText}" Foreground="#93A6B9" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <TabControl Grid.Column="1" Margin="16,0,0,0" Padding="0" Background="Transparent">
        <TabItem Header="概览">
          <ScrollViewer>
            <StackPanel Spacing="14" Margin="0,8,4,4">
              <Border Classes="card">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="6">
                    <TextBlock Text="当前实例" Classes="muted" />
                    <TextBlock Text="{Binding SelectedInstance.Manifest.DisplayName, FallbackValue=未选择实例}"
                               FontSize="24" FontWeight="SemiBold" Foreground="#172331" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Background="#EEF6F1" CornerRadius="6" Padding="8,4">
                        <TextBlock Text="{Binding SelectedInstance.Manifest.BaseVersion, FallbackValue=—}"
                                   FontSize="12" Foreground="#2F7D5A" />
                      </Border>
                      <Border Background="#EEF3F8" CornerRadius="6" Padding="8,4">
                        <TextBlock Text="{Binding SelectedInstance.LoaderDisplay, FallbackValue=—}"
                                   FontSize="12" Foreground="#486274" />
                      </Border>
                      <Border Background="#FFF4E5" CornerRadius="6" Padding="8,4">
                        <TextBlock Text="{Binding SelectedInstance.InstallState, FallbackValue=—}"
                                   FontSize="12" Foreground="#9A641E" />
                      </Border>
                    </StackPanel>
                  </StackPanel>
                  <Button Grid.Column="1" Classes="accent" Content="启动游戏" MinWidth="116"
                          Command="{Binding LaunchCommand}" VerticalAlignment="Center" />
                </Grid>
              </Border>

              <Border Classes="card">
                <StackPanel Spacing="12">
                  <TextBlock Text="创建原版实例" Classes="cardTitle" />
                  <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="10">
                    <TextBox Grid.Column="0" Text="{Binding NewInstanceName}" PlaceholderText="实例名称" />
                    <TextBox Grid.Column="1" Text="{Binding NewVersion}" PlaceholderText="版本 ID，例如 1.20.1 或 26.3" />
                    <Button Grid.Column="2" Classes="accent" Content="创建" Command="{Binding CreateCommand}" />
                  </Grid>
                  <TextBlock Text="安装会从 Mojang 官方元数据解析版本与 Java 要求，下载并校验客户端、库、资源与日志配置。"
                             Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Border Classes="card">
                <StackPanel Spacing="8">
                  <TextBlock Text="当前任务" Classes="cardTitle" />
                  <TextBlock Text="{Binding Status}" Foreground="#8A4F12" TextWrapping="Wrap" />
                  <TextBlock Text="安装与启动的详细输出在“日志”页；加载器安装、模组和整合包已分到独立页面。"
                             Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="加载器">
          <ScrollViewer>
            <StackPanel Spacing="14" Margin="0,8,4,4">
              <Border Classes="card">
                <StackPanel Spacing="12">
                  <TextBlock Text="Fabric" Classes="cardTitle" />
                  <TextBlock Text="留空使用最新稳定 loader；指定版本时按固定版本解析。" Classes="muted" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBox Grid.Column="0" Text="{Binding FabricVersion}" PlaceholderText="Fabric loader 版本（空 = 最新稳定）" />
                    <Button Grid.Column="1" Classes="accent" Content="安装 Fabric" Command="{Binding InstallFabricCommand}" />
                  </Grid>
                </StackPanel>
              </Border>

              <Border Classes="card">
                <StackPanel Spacing="12">
                  <TextBlock Text="Forge / NeoForge" Classes="cardTitle" />
                  <TextBlock Text="必须固定版本；Forge 与 NeoForge 分开验证，不共用结果。" Classes="muted" />
                  <TextBox Text="{Binding ForgeVersion}" PlaceholderText="例如 47.2.0" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Grid.Column="0" Content="安装 Forge" Command="{Binding InstallForgeCommand}" />
                    <Button Grid.Column="1" Content="安装 NeoForge" Command="{Binding InstallNeoForgeCommand}" />
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="模组">
          <Grid ColumnDefinitions="*,*" ColumnSpacing="14" Margin="0,8,4,4">
            <Border Classes="card">
              <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
                <TextBlock Text="本地模组" Classes="cardTitle" />
                <TextBlock Grid.Row="1" Text="仅操作当前实例的 mods 目录；游戏运行中禁止修改。" Classes="muted" TextWrapping="Wrap" />
                <ListBox Grid.Row="2" ItemsSource="{Binding LocalMods}" SelectedItem="{Binding SelectedLocalMod}"
                         Background="#F8FAFC" CornerRadius="8" Padding="6">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LocalModRow">
                      <TextBlock Text="{Binding Display}" TextWrapping="Wrap" FontSize="12" Margin="4" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="8">
                  <Button Grid.Column="0" Content="刷新模组" Command="{Binding RefreshModsCommand}" />
                  <Button Grid.Column="1" Content="启用 / 禁用" Command="{Binding ToggleModCommand}" />
                </Grid>
              </Grid>
            </Border>

            <Border Grid.Column="1" Classes="card">
              <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10">
                <TextBlock Text="Modrinth" Classes="cardTitle" />
                <TextBlock Grid.Row="1" Text="按当前实例的游戏版本和加载器筛选，安装到实例 mods。" Classes="muted" TextWrapping="Wrap" />
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox Grid.Column="0" Text="{Binding ModrinthQuery}" PlaceholderText="搜索模组名称" />
                  <Button Grid.Column="1" Classes="accent" Content="搜索" Command="{Binding SearchModrinthCommand}" />
                </Grid>
                <ListBox Grid.Row="3" ItemsSource="{Binding ModrinthProjects}" SelectedItem="{Binding SelectedModrinthProject}"
                         Background="#F8FAFC" CornerRadius="8" Padding="6">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ModrinthProjectRow">
                      <TextBlock Text="{Binding Display}" TextWrapping="Wrap" FontSize="12" Margin="4" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Button Grid.Row="4" Classes="accent" Content="安装所选模组到当前实例"
                        Command="{Binding InstallModrinthCommand}" />
              </Grid>
            </Border>
          </Grid>
        </TabItem>

        <TabItem Header="整合包">
          <ScrollViewer>
            <StackPanel Spacing="14" Margin="0,8,4,4">
              <Border Classes="card">
                <StackPanel Spacing="12">
                  <TextBlock Text="导入 .mrpack" Classes="cardTitle" />
                  <TextBlock Text="创建新实例，不覆盖现有存档；包内自定义脚本不会执行。"
                             Classes="muted" TextWrapping="Wrap" />
                  <TextBox Text="{Binding MrpackPath}" PlaceholderText="本地 .mrpack 文件完整路径" />
                  <TextBox Text="{Binding MrpackInstanceName}" PlaceholderText="新实例名称" />
                  <Button Classes="accent" Content="导入为新实例" Command="{Binding ImportMrpackCommand}" />
                </StackPanel>
              </Border>
              <Border Classes="card">
                <StackPanel Spacing="8">
                  <TextBlock Text="导入内容" Classes="cardTitle" />
                  <TextBlock Text="索引文件摘要校验、加载器安装、文件下载、overrides 合并。Forge/NeoForge 整合包目前会明确拒绝自动导入。"
                             Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="账号">
          <ScrollViewer>
            <StackPanel Spacing="14" Margin="0,8,4,4">
              <Border Classes="card">
                <StackPanel Spacing="12">
                  <TextBlock Text="当前账号" Classes="cardTitle" />
                  <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:AccountRow">
                        <TextBlock Text="{Binding Display}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0" Text="{Binding LocalDisplayName}" PlaceholderText="本地身份名称" />
                    <Button Grid.Column="1" Content="添加本地身份" Command="{Binding AddLocalCommand}" />
                    <Button Grid.Column="2" Classes="accent" Content="微软登录" Command="{Binding LoginMicrosoftCommand}" />
                  </Grid>
                  <TextBlock Text="本地身份不提供正版会话。微软登录需要 MDCL 专属 public client；未配置时会明确提示条件不足。"
                             Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="日志">
          <Grid RowDefinitions="Auto,*" Margin="0,8,4,4" RowSpacing="10">
            <Border Classes="card" Padding="16">
              <StackPanel Spacing="4">
                <TextBlock Text="运行状态" Classes="cardTitle" />
                <TextBlock Text="{Binding Status}" Foreground="#8A4F12" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Grid.Row="1" Background="#10161D" CornerRadius="12" Padding="12">
              <ListBox ItemsSource="{Binding Logs}" Background="Transparent" BorderThickness="0"
                       FontFamily="Cascadia Mono,Consolas,Menlo" FontSize="12">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" Foreground="#C8D6E5" TextWrapping="Wrap" Margin="2" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
          </Grid>
        </TabItem>
      </TabControl>
    </Grid>
  </Grid>
</Window>
