<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MDCL.Desktop.ViewModels" x:Class="MDCL.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel" Width="960" Height="640" MinWidth="850" MinHeight="560"
        Background="Transparent" Foreground="#344252" FontFamily="Microsoft YaHei UI,Segoe UI,PingFang SC"
        WindowDecorations="None" TransparencyLevelHint="Transparent" Title="{Binding Title}"
        WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="TextBlock"><Setter Property="FontSize" Value="13"/></Style>
    <Style Selector="Button">
      <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#344252"/>
      <Setter Property="BorderBrush" Value="#7A8794"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="3"/><Setter Property="Padding" Value="12,7"/>
      <Setter Property="MinHeight" Value="32"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}"><ContentPresenter Name="PART_MdclContent" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border></ControlTemplate></Setter>
    </Style>
    <Style Selector="Button:pointerover"><Setter Property="Background" Value="#EEF6FF"/><Setter Property="BorderBrush" Value="#087CE8"/><Setter Property="Foreground" Value="#087CE8"/></Style>
    <Style Selector="Button:pressed"><Setter Property="Background" Value="#E0EEFC"/></Style>
    <Style Selector="Button:focus-visible"><Setter Property="BorderBrush" Value="#087CE8"/><Setter Property="BorderThickness" Value="2"/></Style>
    <Style Selector="Button:disabled"><Setter Property="Opacity" Value="0.4"/></Style>
    <Style Selector="Button.accent"><Setter Property="Foreground" Value="#087CE8"/><Setter Property="BorderBrush" Value="#087CE8"/></Style>
    <Style Selector="Button.launch"><Setter Property="Foreground" Value="#087CE8"/><Setter Property="BorderBrush" Value="#087CE8"/><Setter Property="Height" Value="56"/></Style>
    <Style Selector="Button.link"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#6F7D8A"/><Setter Property="Padding" Value="8,4"/><Setter Property="MinHeight" Value="24"/></Style>
    <Style Selector="Button.chrome"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10"/><Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.chrome:pointerover"><Setter Property="Background" Value="#22FFFFFF"/></Style>
    <Style Selector="Button.close:pointerover"><Setter Property="Background" Value="#D64A4A"/></Style>
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="3"/><Setter Property="Padding" Value="10,7"/><Setter Property="MinHeight" Value="32"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#BBCDDD"/><Setter Property="FontSize" Value="12"/></Style>
    <Style Selector="ComboBox"><Setter Property="CornerRadius" Value="3"/><Setter Property="Padding" Value="8,5"/><Setter Property="MinHeight" Value="30"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#94BFEF"/><Setter Property="FontSize" Value="12"/></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="18"/><Setter Property="BoxShadow" Value="0 2 7 0 #120A395C"/></Style>
    <Style Selector="TextBlock.cardTitle"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#374F68"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#697B8C"/></Style>
    <Style Selector="TextBlock.pageTitle"><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#344F6A"/></Style>
    <Style Selector="ListBox"><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="ListBoxItem"><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,2"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Foreground" Value="#344252"/>
      <Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="{TemplateBinding CornerRadius}"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/></Border></ControlTemplate></Setter>
    </Style>
    <Style Selector="ListBoxItem:pointerover"><Setter Property="Background" Value="#EDF5FD"/></Style>
    <Style Selector="ListBoxItem:selected"><Setter Property="Background" Value="#E4F0FD"/><Setter Property="Foreground" Value="#087CE8"/></Style>
    <Style Selector="ListBoxItem:focus-visible"><Setter Property="Background" Value="#D8EAFD"/></Style>
    <Style Selector="ListBox.topNav ListBoxItem"><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="13,5"/><Setter Property="Margin" Value="5,0"/><Setter Property="CornerRadius" Value="16"/></Style>
    <Style Selector="ListBox.topNav ListBoxItem:selected"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#087CE8"/></Style>
    <Style Selector="ListBox.topNav ListBoxItem:pointerover"><Setter Property="Background" Value="#24FFFFFF"/></Style>
    <Style Selector="ListBox.topNav ListBoxItem:selected:pointerover"><Setter Property="Background" Value="White"/></Style>
    <Style Selector="ListBox.topNav Path"><Setter Property="Stroke" Value="White"/><Setter Property="StrokeThickness" Value="1.6"/></Style>
    <Style Selector="ListBox.topNav ListBoxItem:selected Path"><Setter Property="Stroke" Value="#087CE8"/></Style>
    <Style Selector="RadioButton.auth"><Setter Property="Foreground" Value="#087CE8"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="12,5"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="16"><ContentPresenter Content="{TemplateBinding Content}"/></Border></ControlTemplate></Setter>
    </Style>
    <Style Selector="RadioButton.auth:checked"><Setter Property="Background" Value="#087CE8"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="TabControl.pages"><Setter Property="Template"><ControlTemplate><Grid RowDefinitions="0,*"><ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" Height="0" Opacity="0" IsHitTestVisible="False"/><Panel Grid.Row="1" ClipToBounds="True"><ContentPresenter Name="PART_SelectedContentHost2" IsVisible="False"/><ContentPresenter Name="PART_SelectedContentHost"/></Panel></Grid></ControlTemplate></Setter></Style>
  </Window.Styles>
  <Border CornerRadius="6" ClipToBounds="True" Background="#FDFEFF">
    <Grid RowDefinitions="48,*">
      <Border Background="#1075CF" PointerPressed="OnTitlePointerPressed">
        <Grid ColumnDefinitions="150,*,90">
          <TextBlock Text="MDCL" Foreground="White" FontSize="21" Margin="18,0" VerticalAlignment="Center" FontWeight="Medium"/>
          <ListBox Classes="topNav" Grid.ColumnSpan="3" SelectedIndex="{Binding SelectedSectionIndex}" Background="Transparent" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="主导航">
            <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="8"><Path Width="13" Height="14" Stretch="Uniform" Data="M 2,1 L 12,7 L 2,13 Z"/><TextBlock Text="启动" FontSize="12" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
            <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="8"><Path Width="14" Height="14" Stretch="Uniform" Data="M 7,0 L 7,9 M 3,5 L 7,9 L 11,5 M 1,9 L 1,13 L 13,13 L 13,9"/><TextBlock Text="下载" FontSize="12" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
            <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="8"><Path Width="15" Height="14" Stretch="Uniform" Data="M 4,1 L 11,1 L 15,7 L 11,13 L 4,13 L 0,7 Z M 10,7 A 2.5,2.5 0 1 1 5,7 A 2.5,2.5 0 1 1 10,7"/><TextBlock Text="设置" FontSize="12" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
            <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="8"><Path Width="14" Height="14" Stretch="Uniform" Data="M 0,0 L 5,0 L 5,5 L 0,5 Z M 9,0 L 14,0 L 14,5 L 9,5 Z M 0,9 L 5,9 L 5,14 L 0,14 Z M 9,9 L 14,9 L 14,14 L 9,14 Z"/><TextBlock Text="更多" FontSize="12" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
          </ListBox>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0">
            <Button Classes="chrome" Click="OnMinimizeClick" ToolTip.Tip="最小化" AutomationProperties.Name="最小化"><Path Width="12" Height="1" Data="M 0,0 L 12,0" Stroke="White" StrokeThickness="1.6"/></Button>
            <Button Classes="chrome close" Click="OnCloseClick" ToolTip.Tip="关闭" AutomationProperties.Name="关闭"><Path Width="12" Height="12" Data="M 0,0 L 12,12 M 12,0 L 0,12" Stroke="White" StrokeThickness="1.6"/></Button>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding SidebarWidth}"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border BorderBrush="#CEDCEE" BorderThickness="0,0,1,0" Background="#FDFEFF">
          <Grid>
            <Grid IsVisible="{Binding IsLaunchSection}" RowDefinitions="Auto,*,Auto" Margin="20,22,20,20">
              <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                <RadioButton Classes="auth" GroupName="AccountMode" IsChecked="{Binding IsMicrosoftMode}" Content="正版"/>
                <RadioButton Classes="auth" GroupName="AccountMode" IsChecked="{Binding IsLocalMode}" Content="本地资料"/>
              </StackPanel>
              <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="22" Margin="0,0,0,24">
                <Path Width="42" Height="48" Stretch="Uniform" Stroke="#5B9AD2" StrokeThickness="2.8" StrokeLineCap="Round" HorizontalAlignment="Center" Data="M 30,10 A 8,8 0 1 1 14,10 A 8,8 0 1 1 30,10 M 8,38 C 8,19 36,19 36,38"/>
                <Grid ColumnDefinitions="*,60" ColumnSpacing="10">
                  <ComboBox ItemsSource="{Binding ModeAccounts}" SelectedItem="{Binding SelectedAccount}" PlaceholderText="添加新账号" HorizontalAlignment="Stretch" AutomationProperties.Name="当前游戏账号">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:AccountRow"><TextBlock Text="{Binding Profile.DisplayName}" FontSize="12" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Grid.Column="1" Classes="accent" Content="管理" Command="{Binding OpenAccountsCommand}"/>
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="14" Margin="0,-1,0,0"><Button Classes="link" Content="账号管理" Command="{Binding OpenAccountsCommand}"/><Button Classes="link" Content="刷新列表" Command="{Binding RefreshCommand}"/></StackPanel>
              </StackPanel>
              <StackPanel Grid.Row="2" Spacing="10">
                <Button Classes="launch" Command="{Binding PrimaryActionCommand}" HorizontalAlignment="Stretch">
                  <StackPanel Spacing="4"><TextBlock Text="{Binding PrimaryActionLabel}" Foreground="#087CE8" FontSize="15" HorizontalAlignment="Center"/><TextBlock Text="{Binding PrimaryActionDetail}" Foreground="#697B8C" FontSize="11" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="232"/></StackPanel>
                </Button>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10"><Button Content="版本选择" Command="{Binding OpenVersionsCommand}" HorizontalAlignment="Stretch"/><Button Grid.Column="1" Content="版本设置" Command="{Binding OpenSettingsCommand}" HorizontalAlignment="Stretch"/></Grid>
              </StackPanel>
            </Grid>
            <Grid IsVisible="{Binding !IsLaunchSection}" RowDefinitions="Auto,*,Auto" Margin="12,22,12,18">
              <TextBlock Text="{Binding SidebarTitle}" Foreground="#7B8A9B" FontSize="12" Margin="15,0,0,17"/>
              <ListBox Grid.Row="1" ItemsSource="{Binding SidebarItems}" SelectedItem="{Binding SelectedSidebar}" Background="Transparent" Padding="0" AutomationProperties.Name="功能导航">
                <ListBox.ItemTemplate><DataTemplate x:DataType="vm:PageNavigationRow"><TextBlock Text="{Binding Label}" FontSize="13" Margin="3,3"/></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <Button Grid.Row="2" Classes="link" Content="返回启动页" Command="{Binding OpenHomeCommand}" HorizontalAlignment="Center"/>
            </Grid>
          </Grid>
        </Border>
        <Border Grid.Column="1">
          <Border.Background><LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%"><GradientStop Color="#D8E6F6" Offset="0"/><GradientStop Color="#CEE8F1" Offset="1"/></LinearGradientBrush></Border.Background>
          <Grid RowDefinitions="Auto,*">
            <Border IsVisible="{Binding ShowInstanceContext}" Margin="20,14,20,0">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><TextBlock Text="当前版本" Classes="muted" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}" PlaceholderText="请选择版本" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:InstanceRow"><TextBlock Text="{Binding Display}" FontSize="12" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid>
            </Border>
          <TabControl Grid.Row="1" Classes="pages" Margin="20" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent">
            <TabItem Header="启动"><Grid AutomationProperties.Name="启动页背景"/></TabItem>
        <TabItem Header="加载器">
          <ScrollViewer>
            <StackPanel Spacing="18" Margin="0,0,4,4">
              <Border Classes="card">
                <StackPanel Spacing="12">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Width="34" Height="34" CornerRadius="9" Background="#EAF5FC">
                      <TextBlock Text="F" Foreground="#1479BF" FontWeight="Bold" FontSize="17"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Fabric" Classes="cardTitle" />
                      <TextBlock Text="轻量模组加载器，留空使用最新稳定版本。" Classes="muted" />
                    </StackPanel>
                  </StackPanel>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBox Grid.Column="0" Text="{Binding FabricVersion}" PlaceholderText="Fabric loader 版本（空 = 最新稳定）" />
                    <Button Grid.Column="1" Classes="accent" Content="安装 Fabric" Command="{Binding InstallFabricCommand}" />
                  </Grid>
                </StackPanel>
              </Border>

              <Border Classes="card">
                <StackPanel Spacing="12">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Width="34" Height="34" CornerRadius="9" Background="#FFF0E5">
                      <TextBlock Text="F" Foreground="#B85E17" FontWeight="Bold" FontSize="17"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Forge / NeoForge" Classes="cardTitle" />
                      <TextBlock Text="必须固定版本；Forge 与 NeoForge 分开安装，不共用结果。" Classes="muted" />
                    </StackPanel>
                  </StackPanel>
                  <TextBox Text="{Binding ForgeVersion}" PlaceholderText="例如 47.2.0 / 47.1.106" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Grid.Column="0" Content="安装 Forge" Command="{Binding InstallForgeCommand}" />
                    <Button Grid.Column="1" Content="安装 NeoForge" Command="{Binding InstallNeoForgeCommand}" />
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="模组">
          <Grid ColumnDefinitions="*,*" ColumnSpacing="18" Margin="0,0,4,4">
            <Border Classes="card">
              <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
                <TextBlock Text="本地模组" Classes="cardTitle" />
                <TextBlock Grid.Row="1" Text="仅操作当前实例的 mods 目录；游戏运行中禁止修改。" Classes="muted" TextWrapping="Wrap" />
                <ListBox Grid.Row="2" ItemsSource="{Binding LocalMods}" SelectedItem="{Binding SelectedLocalMod}"
                         Background="#F6F9FC" CornerRadius="5" Padding="6">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LocalModRow">
                      <TextBlock Text="{Binding Display}" TextWrapping="Wrap" FontSize="12" Margin="6,3" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="8">
                  <Button Grid.Column="0" Content="刷新模组" Command="{Binding RefreshModsCommand}" />
                  <Button Grid.Column="1" Content="启用 / 禁用" Command="{Binding ToggleModCommand}" />
                </Grid>
              </Grid>
            </Border>

            <Border Grid.Column="1" Classes="card">
              <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10">
                <TextBlock Text="Modrinth" Classes="cardTitle" />
                <TextBlock Grid.Row="1" Text="按当前实例的游戏版本和加载器筛选，安装到实例 mods。" Classes="muted" TextWrapping="Wrap" />
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox Grid.Column="0" Text="{Binding ModrinthQuery}" PlaceholderText="搜索模组名称" />
                  <Button Grid.Column="1" Classes="accent" Content="搜索" Command="{Binding SearchModrinthCommand}" />
                </Grid>
                <ListBox Grid.Row="3" ItemsSource="{Binding ModrinthProjects}" SelectedItem="{Binding SelectedModrinthProject}"
                         Background="#F6F9FC" CornerRadius="5" Padding="6">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ModrinthProjectRow">
                      <TextBlock Text="{Binding Display}" TextWrapping="Wrap" FontSize="12" Margin="6,3" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Button Grid.Row="4" Classes="accent" Content="安装所选模组到当前实例"
                        Command="{Binding InstallModrinthCommand}" />
              </Grid>
            </Border>
          </Grid>
        </TabItem>

        <TabItem Header="整合包">
          <ScrollViewer>
            <StackPanel Spacing="18" Margin="0,0,4,4">
              <Border Classes="card">
                <StackPanel Spacing="12">
                  <TextBlock Text="导入 .mrpack" Classes="cardTitle" />
                  <TextBlock Text="创建新实例，不覆盖现有存档；包内自定义脚本不会执行。"
                             Classes="muted" TextWrapping="Wrap" />
                  <TextBox Text="{Binding MrpackPath}" PlaceholderText="本地 .mrpack 文件完整路径" />
                  <TextBox Text="{Binding MrpackInstanceName}" PlaceholderText="新实例名称" />
                  <Button Content="预览整合包" Command="{Binding PreviewMrpackCommand}" />
                  <TextBlock Text="{Binding MrpackPreviewText}" TextWrapping="Wrap" />
                  <Button Classes="accent" Content="确认导入 / 恢复未完成导入" Command="{Binding ImportMrpackCommand}" />
                </StackPanel>
              </Border>
              <Border Classes="card">
                <StackPanel Spacing="8">
                  <TextBlock Text="导入内容" Classes="cardTitle" />
                  <TextBlock Text="索引文件摘要校验、加载器安装、文件下载、overrides 合并。支持 Vanilla、Fabric、Forge 与 NeoForge 固定版本导入。"
                             Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="账号">
          <ScrollViewer>
            <StackPanel Spacing="18" Margin="0,0,4,4">
              <Border Classes="card">
                <StackPanel Spacing="12">
                  <TextBlock Text="当前账号" Classes="cardTitle" />
                  <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:AccountRow">
                        <TextBlock Text="{Binding Display}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Content="退出 / 移除当前账号" Command="{Binding LogoutCommand}" />
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0" Text="{Binding LocalDisplayName}" PlaceholderText="本地身份名称" />
                    <Button Grid.Column="1" Content="添加本地身份" Command="{Binding AddLocalCommand}" />
                    <Button Grid.Column="2" Classes="accent" Content="微软登录" Command="{Binding LoginMicrosoftCommand}" />
                  </Grid>
                  <TextBlock Text="启动游戏需要通过身份和 Java 版权益验证的微软账号。本地资料仅保留配置与数据，不再用于免认证启动。"
                             Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Classes="card">
                <Expander Header="微软登录应用设置" IsExpanded="{Binding !IsMicrosoftConfigured}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                  <StackPanel Spacing="10" Margin="0,12,0,0">
                    <TextBlock Text="应用程序（客户端）ID" />
                    <TextBox Text="{Binding MicrosoftClientId}" PlaceholderText="MDCL 在 Microsoft Entra 中的 Client ID" />
                    <TextBlock Text="{Binding MicrosoftClientIdHint}" Classes="muted" TextWrapping="Wrap" />
                    <TextBlock Text="注册应用时使用以下桌面回调地址" />
                    <TextBox Text="{Binding MicrosoftCallbackUri}" IsReadOnly="True" />
                    <Button Classes="accent" Content="保存应用 ID" Command="{Binding SaveMicrosoftClientIdCommand}" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding MicrosoftConfigurationStatus}" Classes="muted" TextWrapping="Wrap" />
                  </StackPanel>
                </Expander>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="日志">
          <Grid RowDefinitions="Auto,*" Margin="0,0,4,4" RowSpacing="10">
            <Border Classes="card" Padding="16">
              <StackPanel Spacing="4">
                <TextBlock Text="运行状态" Classes="cardTitle" />
                <TextBlock Text="{Binding Status}" Foreground="#8A5A12" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Content="生成诊断预览" Command="{Binding PreviewDiagnosticsCommand}" />
                  <Button Content="导出已预览诊断包" Command="{Binding ExportDiagnosticsCommand}" />
                </StackPanel>
                <TextBox Text="{Binding DiagnosticPreview}" IsReadOnly="True" AcceptsReturn="True" MaxHeight="160" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Grid.Row="1" Background="#21384C" CornerRadius="6" Padding="12">
              <ListBox ItemsSource="{Binding Logs}" Background="Transparent" BorderThickness="0"
                       FontFamily="Cascadia Mono,Consolas,Menlo" FontSize="12">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" Foreground="#E1ECF4" TextWrapping="Wrap" Margin="2" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
          </Grid>
        </TabItem>
        <TabItem Header="设置">
          <ScrollViewer>
            <StackPanel Spacing="18" Margin="0,0,4,4">
              <Border Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Text="当前实例设置" Classes="cardTitle" />
                  <TextBlock Text="实例名称" />
                  <TextBox Text="{Binding EditInstanceName}" />
                  <TextBlock Text="内存（MiB）" />
                  <NumericUpDown Value="{Binding EditMemoryMiB}" Minimum="512" Maximum="131072" Increment="512" />
                  <TextBlock Text="Java 选择" />
                  <ComboBox ItemsSource="{Binding JavaRuntimes}" SelectedItem="{Binding SelectedJavaRuntime}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:JavaRuntimeRow"><TextBlock Text="{Binding Display}" /></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="重新发现 Java" Command="{Binding RefreshJavaCommand}" />
                    <Button Classes="accent" Content="保存实例设置" Command="{Binding SaveInstanceSettingsCommand}" />
                  </StackPanel>
                  <TextBlock Text="手动绑定失效时会显示错误；选择自动并保存后，恢复按版本和架构选择。" TextWrapping="Wrap" Classes="muted" />
                </StackPanel>
              </Border>
              <Border Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Text="复制与回收" Classes="cardTitle" />
                  <TextBox Text="{Binding CopyInstanceName}" PlaceholderText="副本名称" />
                  <Button Content="复制当前实例" Command="{Binding CopyInstanceCommand}" />
                  <TextBlock Text="当前实例及其目录将移入 MDCL 回收区，共享下载库保留。可在下方恢复；运行中的实例不能移动。" TextWrapping="Wrap" />
                  <CheckBox Content="确认将左侧当前实例移入回收区" IsChecked="{Binding ConfirmTrash}" />
                  <Button Content="移入回收区" Command="{Binding TrashInstanceCommand}" />
                  <ComboBox ItemsSource="{Binding TrashInstances}" SelectedItem="{Binding SelectedTrashInstance}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:InstanceRow"><TextBlock Text="{Binding Manifest.DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Content="恢复选中的实例" Command="{Binding RestoreInstanceCommand}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="游戏下载">
          <ScrollViewer><StackPanel Spacing="18" Margin="0,0,4,4">
            <Border Classes="card"><StackPanel Spacing="15">
              <TextBlock Text="下载游戏" Classes="cardTitle"/>
              <TextBlock Text="创建一个独立的 Minecraft 实例" Classes="muted"/>
              <TextBlock Text="游戏版本"/><TextBox Text="{Binding NewVersion}" PlaceholderText="Mojang 版本 ID，例如 1.20.1 或 26.3"/>
              <TextBlock Text="版本名称"/><TextBox Text="{Binding NewInstanceName}" PlaceholderText="为这个实例取一个名字"/>
              <Button Classes="accent" Content="创建版本" Command="{Binding CreateCommand}" HorizontalAlignment="Left"/>
            </StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="12">
              <TextBlock Text="安装与修复" Classes="cardTitle"/>
              <ComboBox ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}" HorizontalAlignment="Stretch" PlaceholderText="请选择实例"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:InstanceRow"><TextBlock Text="{Binding Display}" FontSize="12"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
              <TextBlock Text="下载官方元数据、客户端与资源；已有文件会先校验，再修复缺失内容。" Classes="muted" TextWrapping="Wrap"/>
              <Button Classes="accent" Content="安装 / 修复所选版本" Command="{Binding InstallCommand}" HorizontalAlignment="Left"/>
            </StackPanel></Border>
          </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem Header="版本选择">
          <Grid RowDefinitions="Auto,*,Auto" RowSpacing="15">
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="版本选择" Classes="pageTitle" VerticalAlignment="Center"/><Button Grid.Column="1" Classes="accent" Content="添加版本" Command="{Binding OpenDownloadCommand}"/></Grid>
            <Border Grid.Row="1" Classes="card" Padding="8">
              <ListBox ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}" Background="Transparent" Padding="0" AutomationProperties.Name="版本列表">
                <ListBox.ItemTemplate><DataTemplate x:DataType="vm:InstanceRow"><Grid ColumnDefinitions="36,*" ColumnSpacing="13" Margin="3,6"><Path Width="26" Height="26" Stretch="Uniform" Stroke="#5494D1" StrokeThickness="1.4" Data="M 0,7 L 13,0 L 26,7 L 13,14 Z M 0,7 L 0,22 L 13,29 L 26,22 L 26,7 M 13,14 L 13,29"/><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="{Binding Manifest.DisplayName}" FontSize="14"/><TextBlock Text="{Binding Details}" Classes="muted"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
            </Border>
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10"><TextBlock Text="选择后，左侧启动按钮会使用这个版本。" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center"/><Button Grid.Column="1" Content="返回启动" Command="{Binding OpenHomeCommand}"/></Grid>
          </Grid>
        </TabItem>
        <TabItem Header="关于 MDCL">
          <ScrollViewer><StackPanel Spacing="18" Margin="0,0,4,4">
            <Border Classes="card"><StackPanel Spacing="14"><TextBlock Text="MountainDogCraftLauncher" FontSize="22" Foreground="#245F9B"/><TextBlock Text="{Binding Subtitle}" Classes="muted"/><Border Height="1" Background="#E7EDF4"/><TextBlock Text="独立实例，官方资源下载，自动选择 Java。" TextWrapping="Wrap"/><TextBlock Text="源码许可证：MIT。第三方组件保留各自许可证。" Classes="muted" TextWrapping="Wrap"/></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="开发预览版" Classes="cardTitle"/><TextBlock Text="macOS 真机、微软真实登录与签名/公证尚未实测。Fabric 首次 remap 在本机仍未通过；完整边界随发布附验收记录。" Classes="muted" TextWrapping="Wrap"/><TextBlock Text="生产更新信任链未配置，桌面自动更新尚未启用。" Classes="muted" TextWrapping="Wrap"/></StackPanel></Border>
          </StackPanel></ScrollViewer>
        </TabItem>

          </TabControl>
          </Grid>
        </Border>
        <Border Grid.Column="1" IsVisible="{Binding ShowTaskPanel}" Background="White" CornerRadius="6" Padding="15" Margin="20" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" BoxShadow="0 3 12 0 #220D426A">
          <StackPanel Spacing="9"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><TextBlock Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" MaxHeight="65"/><Button Grid.Column="1" Classes="link" Content="收起" Command="{Binding DismissStatusCommand}" IsVisible="{Binding !HasActiveWork}"/></Grid><ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" Height="3" Foreground="#087CE8"/><TextBlock Text="{Binding ProgressText}" Classes="muted" FontSize="11" TextWrapping="Wrap" MaxHeight="35" IsVisible="{Binding IsBusy}"/><StackPanel Orientation="Horizontal" Spacing="10"><Button Content="取消当前任务" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}"/><Button Content="停止游戏" Command="{Binding StopCommand}" IsVisible="{Binding IsGameRunning}"/></StackPanel></StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
